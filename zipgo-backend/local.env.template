# ─────────────────────────────────────────────────────────────
# Local settings for this computer. start-zipgo.bat copies this to ".env"
# the first time and adds a random JWT_SECRET (and your WhatsApp settings
# from the old map backend, if it finds them).
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# The website running with "npm run dev"
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174

# ── Database ─────────────────────────────────────────────────
# For now: a local file (zipgo-backend/data/zipgo-dev.sqlite), nothing to install.
# When your Oracle database is ready: set DB_CLIENT=oracle and fill in the lines below.
DB_CLIENT=sqlite
SQLITE_FILE=./data/zipgo-dev.sqlite

ORACLE_USER=zipgo
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
ORACLE_POOL_MAX=10
ORACLE_WALLET_DIR=
ORACLE_WALLET_PASSWORD=
DB_AUTO_MIGRATE=true

# ── Login codes ──────────────────────────────────────────────
OTP_TTL_SECONDS=300
# While testing, this code always works and is shown on the login screen
OTP_DEV_CODE=123456
# "text" works with the test numbers in your Meta app. Use "template" once your
# Authentication template is approved.
WHATSAPP_MESSAGE_TYPE=text
WHATSAPP_TEMPLATE_NAME=zipgo_login_code
WHATSAPP_TEMPLATE_LANG=en

# ── Pricing (PKR) ────────────────────────────────────────────
BASE_FARE=80
PER_KM_RATE=25
PEAK_MULTIPLIER=1.3
PEAK_HOURS=12-15,19-22
APP_TIMEZONE=Asia/Karachi

# ── Dispatch ─────────────────────────────────────────────────
DISPATCH_RADIUS_KM=10
OFFER_SECONDS=30
MAX_DECLINES=3
PENDING_TIMEOUT_SECONDS=120
RIDER_STALE_MINUTES=10

# ── Service area (Lahore) ────────────────────────────────────
SERVICE_CENTER_LAT=31.5204
SERVICE_CENTER_LNG=74.3587
SERVICE_RADIUS_KM=60

# ── Maps (free, no key) ──────────────────────────────────────
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEO_USER_AGENT=ZipGoExpress/1.0 (contactzipgopk@gmail.com)
