# Copy this file to  deploy/.env.production  on the server and fill it in.
# Never put this file in git or send it in chat.

# Long random text (32+ characters). Make one with:  openssl rand -hex 32
JWT_SECRET=

# Websites allowed to use the API (comma separated, no trailing slash)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ---- Oracle Autonomous Database (from DEPLOY.md step 2)
ORACLE_USER=zipgo
ORACLE_PASSWORD=
# TLS (no wallet) example:  (description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.xx-xxxx-1.oraclecloud.com))(connect_data=(service_name=xxxx_zipgo_high.adb.oraclecloud.com)))
ORACLE_CONNECT_STRING=
# Only if you use the wallet: put the unzipped wallet files in deploy/wallet and set
#   ORACLE_WALLET_DIR=/app/wallet   and   ORACLE_WALLET_PASSWORD=<the wallet password>
ORACLE_WALLET_DIR=
ORACLE_WALLET_PASSWORD=

# ---- Cloudflare Tunnel token (DEPLOY.md step 4)
TUNNEL_TOKEN=

# ---- WhatsApp login codes (Meta). Leave empty until you have them.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_MESSAGE_TYPE=template
WHATSAPP_TEMPLATE_NAME=zipgo_login_code
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
