# ─────────────────────────────────────────────────────────────
# ZipGo backend settings. Copy this file to ".env" and fill it in.
# ─────────────────────────────────────────────────────────────

# development | production
NODE_ENV=development
PORT=4000

# Long random text. In production the server refuses to start without it.
# Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# Website addresses allowed to call the API (comma separated).
# Use * only while developing.
CORS_ORIGINS=http://localhost:5173,https://zipgologistics.pro

# ── Database ─────────────────────────────────────────────────
# oracle  = your Oracle Database (production)
# sqlite  = a local file, for trying the API without Oracle (needs Node 22.5+)
DB_CLIENT=oracle

# Oracle connection (Thin mode — no Oracle Instant Client needed)
ORACLE_USER=zipgo
ORACLE_PASSWORD=change-me
# host:port/service_name   e.g. localhost:1521/FREEPDB1
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
ORACLE_POOL_MAX=10
# Only for Oracle Autonomous Database (cloud) — folder with the unzipped wallet
ORACLE_WALLET_DIR=
ORACLE_WALLET_PASSWORD=

# Create the tables automatically on start (safe to leave on)
DB_AUTO_MIGRATE=true

# Used only when DB_CLIENT=sqlite
SQLITE_FILE=./data/zipgo-dev.sqlite

# ── Login codes (WhatsApp OTP) ───────────────────────────────
OTP_TTL_SECONDS=300
# Development only: this code always works and codes are printed in the console.
# Ignored when NODE_ENV=production.
OTP_DEV_CODE=123456

# Meta WhatsApp Cloud API (leave empty to skip sending while developing)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# template = approved "Authentication" template with one {{1}} code and a copy-code button
# text     = plain message (only reaches test numbers / people who messaged you in the last 24h)
WHATSAPP_MESSAGE_TYPE=template
WHATSAPP_TEMPLATE_NAME=zipgo_login_code
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0
# Meta webhook: https://<your-api>/api/v1/webhooks/whatsapp
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── Pricing (PKR) ────────────────────────────────────────────
BASE_FARE=80
PER_KM_RATE=25
PEAK_MULTIPLIER=1.3
# Peak windows in 24h time, local to APP_TIMEZONE
PEAK_HOURS=12-15,19-22
APP_TIMEZONE=Asia/Karachi

# ── Dispatch ─────────────────────────────────────────────────
DISPATCH_RADIUS_KM=10
# Seconds nearby riders get before the order goes to every online rider
OFFER_SECONDS=30
# Declines after which the order fails
MAX_DECLINES=3
# Seconds after which an order nobody accepted fails
PENDING_TIMEOUT_SECONDS=120
# Riders with no location update for this long are set offline
RIDER_STALE_MINUTES=10

# ── Service area ─────────────────────────────────────────────
SERVICE_CENTER_LAT=31.5204
SERVICE_CENTER_LNG=74.3587
# Pickup and dropoff must be within this distance of the center (0 = no limit)
SERVICE_RADIUS_KM=60

# ── Routing ──────────────────────────────────────────────────
# Free public OSRM server (rate limited). Point to your own OSRM for production.
OSRM_URL=https://router.project-osrm.org
# Address search (free public server, max 1 request per second — the backend queues and caches)
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEO_USER_AGENT=ZipGoExpress/1.0 (contactzipgopk@gmail.com)
